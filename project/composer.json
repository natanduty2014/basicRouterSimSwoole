{
    "name": "vibecriativa/app",
    "description": "Mini framework com slim 4, swoole e  eloquent - VibeCriativa",
    "autoload": {
        "files": [
            "helpers/constants.php"
        ],
        "psr-4": {
            "App\\": "site/",
            "Functions\\": "functions/",
            "Tests\\": "site/tests/"
        }
    },
    "authors": [
        {
            "name": "Natanyel Henrique Carvalho Eduardo Monteiro Monteiro"
        }
    ],
    "require": {
        "firebase/php-jwt": "7.0.5",
        "ext-json": "*",
        "monolog/monolog": "3.9.0",
        "phpmailer/phpmailer": "6.10",
        "nyholm/psr7": "1.8.2",
        "slim/slim": "4.14.0",
        "imefisto/psr-swoole-native": "2.0.2",
        "swoole/ide-helper": "6.0.2",
        "slim/psr7": "1.7.1",
        "php-di/php-di": "7.0.11",
        "textalk/websocket": "1.6.3",
        "illuminate/database": "^11",
        "illuminate/pagination": "11.45",
        "zircote/swagger-php": "^5.1.4",
        "doctrine/annotations": "^2.0.2",
        "hyperf/db": "^3.1",
        "hyperf/pool": "^3.1",
        "hyperf/contract": "^3.1",
        "hyperf/di": "^3.1",
        "hyperf/db-connection": "^3.1",
        "illuminate/events": "^11",
        "hyperf/paginator": "^3.1",
        "aws/aws-sdk-php": "^3.369"
    },
    "require-dev": {
        "phpunit/phpunit": "10.5.63",
        "phpstan/phpstan": "^1.10",
        "symfony/var-dumper": "^7.3"
    }
}